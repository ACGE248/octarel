# Copy to .env locally. Never commit real values.
# Paths are placeholders — do not check in machine-specific locations.

# Optional override for Octarel SQLite/state (directory, not a managed repo).
# OCTAREL_STATE_DIR=/path/to/octarel-state

# Optional OctaScene checkout used only when auto-registering the first managed project.
# OCTAREL_OCTASCENE_ROOT=/path/to/octages-checkout
