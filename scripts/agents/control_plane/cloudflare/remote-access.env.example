# ENG-AGENT-02-S6: Control Center remote-access environment variables. Zero
# secrets -- an Access application AUD tag and team domain are identifiers,
# not credentials (they are safe to see in a URL/JWT, and grant nothing on
# their own without a real, cryptographically signed Cloudflare Access JWT).
#
# Copy to `remote-access.env` (gitignored) next to this file, fill in your
# real values, then `source` it before launching the dashboard, e.g.:
#
#   source scripts/agents/control_plane/cloudflare/remote-access.env
#   python -m octarel dashboard
#
# Every variable defaults to disabled/empty if unset -- remote access is
# opt-in and the dashboard's pure-local behavior is completely unaffected
# until OCTAGES_ORCH_REMOTE_ENABLED is set to a truthy value.

# Master switch. Unset or any value other than 1/true/yes/on keeps the
# dashboard exactly as local-only as it was before ENG-AGENT-02-S6.
export OCTAGES_ORCH_REMOTE_ENABLED=1

# The public hostname Cloudflare Tunnel serves this dashboard at. Used only
# for the CSRF/origin check on state-changing requests -- never trusted as
# an identity signal on its own.
export OCTAGES_ORCH_REMOTE_HOSTNAME=dev.octascene.com

# Your Cloudflare Zero Trust team domain, e.g. "yourteam.cloudflareaccess.com"
# (Zero Trust -> Settings -> Custom Pages, or the URL of your team's Access
# login page). Used to fetch Cloudflare's public signing keys
# (https://<team domain>/cdn-cgi/access/certs) and to verify the token's
# issuer claim.
export OCTAGES_ORCH_REMOTE_TEAM_DOMAIN=YOUR_TEAM.cloudflareaccess.com

# The Access application's Audience (AUD) tag: Zero Trust -> Access ->
# Applications -> (your dev.octascene.com application) -> Overview. A JWT
# whose "aud" claim does not match this exact value is rejected, even if it
# is otherwise validly signed by Cloudflare -- this scopes trust to *this*
# application only, not any Access-protected app on your account.
export OCTAGES_ORCH_REMOTE_AUD=YOUR_ACCESS_APPLICATION_AUD_TAG

# Comma-separated allowlist of the email address(es) allowed to use the
# Control Center remotely. Strongly recommended: leaving this empty accepts
# *any* identity your Access policy already authenticated, which is fine if
# your Access policy itself is already a one-email allowlist, but redundant
# defense in depth costs nothing here.
export OCTAGES_ORCH_REMOTE_ALLOWED_EMAILS=you@example.com
